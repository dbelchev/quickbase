{
  "name": "quickbase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local ./node_modules/turbo/bin/turbo run dev",
    "dev:tickets": "node --env-file-if-exists=.env.local ./node_modules/turbo/bin/turbo run dev --filter=@quickbase/tickets",
    "build": "turbo run build",
    "start": "node --env-file-if-exists=.env.local ./node_modules/turbo/bin/turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:watch": "turbo run //#test:projects:watch",
    "check-types": "turbo run check-types",
    "test:projects:watch": "vitest --watch"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "eslint-config-next": "16.2.4",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  }
}
